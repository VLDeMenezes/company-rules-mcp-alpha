# HTTP server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Local persistence (created automatically on startup, ignored by git)
DATA_DIR=./data

# Initial admin user, only used when data/users.json does not exist yet
INITIAL_ADMIN_EMAIL=admin@company.com
INITIAL_ADMIN_PASSWORD=change-me-please
INITIAL_ADMIN_GITHUB_USERNAME=admin

# Secret used to sign session cookies (minimum 32 characters)
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
